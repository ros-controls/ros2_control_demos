Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Frames:
        tool0:
          Value: true
    - Class: rviz_default_plugins/Marker
      Name: CommandedPath
      Enabled: true
      Topic:
        Value: /cartesian_motion/commanded_path
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.0
      Focal Point:
        X: 0.3
        Y: 0.0
        Z: 0.5
      Pitch: 0.4
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1200

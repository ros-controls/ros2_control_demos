        <mxCell id="hardwareInfo" value="hardware_interface::&lt;br&gt;HardwareInfo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="710" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="ctrlSpec" value="controller_manager::ControllerSpec" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="480" y="320" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="ctrlSpecSep" value="" style="line;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="350" width="260" height="4" as="geometry"/></mxCell>
        <mxCell id="ctrlSpecAttr" value="+ controller_type: string&#xa;+ controller_name: string" style="text;html=1;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="486" y="356" width="248" height="50" as="geometry"/></mxCell>

        <mxCell id="note1" value="in example_1&lt;br&gt;&lt;b&gt;RRBotSystemPositionOnlyHardware&lt;/b&gt; is a&lt;br&gt;concrete implementation of the&lt;br&gt;&lt;b&gt;system interface&lt;/b&gt;" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="1340" y="220" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="sysIface" value="hardware_interface::&lt;br&gt;SystemInterface" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="310" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="system" value="hardware_interface::System" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="390" width="200" height="50" as="geometry"/></mxCell>
        <mxCell id="rrbotHw" value="RRBotSystemPositionOnlyHardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1580" y="390" width="220" height="50" as="geometry"/></mxCell>

<mxfile host="app.diagrams.net">
  <diagram name="Example1UML">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="UML Class Diagram of ROS2 Control Demo Example 1" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="10" width="620" height="30" as="geometry"/></mxCell>
        <mxCell id="lifecycleIface" value="rclcpp_lifecycle::node_interfaces::&lt;br&gt;LifecycleNodeInterface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="50" width="300" height="50" as="geometry"/></mxCell>

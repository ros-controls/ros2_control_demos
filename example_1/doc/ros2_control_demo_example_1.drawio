        <mxCell id="note3" value="in example_1 we are using&lt;br&gt;&lt;b&gt;rrbot_controllers.yaml&lt;/b&gt; file" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="280" y="675" width="180" height="55" as="geometry"/></mxCell>
        <mxCell id="note4" value="the &lt;b&gt;rrbot.urdf.xacro&lt;/b&gt; file provides the&lt;br&gt;robot config used in example_1." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="675" width="240" height="55" as="geometry"/></mxCell>
        <mxCell id="rclcppNode" value="rclcpp::Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="700" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="note5" value="the controller manager is a standard&lt;br&gt;unmanaged ROS2 node" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="780" width="260" height="55" as="geometry"/></mxCell>

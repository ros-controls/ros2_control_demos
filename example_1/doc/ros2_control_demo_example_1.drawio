        <mxCell id="ros2ctrlCont" value="ros2_controllers" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#666666;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="380" height="200" as="geometry"/></mxCell>
        <mxCell id="jsBroadcaster" value="joint_state_broadcaster::&lt;br&gt;JointStateBroadcaster" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ros2ctrlCont"><mxGeometry x="20" y="30" width="340" height="35" as="geometry"/></mxCell>
        <mxCell id="fwdCtrlBase" value="forward_command_controller::&lt;br&gt;ForwardControllersBase" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ros2ctrlCont"><mxGeometry x="20" y="75" width="340" height="35" as="geometry"/></mxCell>
        <mxCell id="fwdCmdCtrl" value="forward_command_controller::&lt;br&gt;ForwardCommandController" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;" vertex="1" parent="ros2ctrlCont"><mxGeometry x="50" y="120" width="300" height="35" as="geometry"/></mxCell>
        <mxCell id="note2" value="in example 1, the setup uses only the&lt;br&gt;&lt;b&gt;joint state broadcaster&lt;/b&gt; and the&lt;br&gt;&lt;b&gt;forward position controller&lt;/b&gt;. While it's&lt;br&gt;possible to include a joint trajectory&lt;br&gt;controller as well." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="yamlCfg" value="&amp;laquo;yaml&amp;raquo;&lt;br&gt;controllers_config" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="600" width="160" height="55" as="geometry"/></mxCell>

        <mxCell id="loanedCmd" value="hardware_interface::&lt;br&gt;LoanedCommandInterface" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="190" height="50" as="geometry"/></mxCell>
